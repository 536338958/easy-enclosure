{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "outDir": ".verify-build",
    "rootDir": "src/app/core",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/app/core/**/*.ts"],
  "exclude": ["src/app/core/**/*.spec.ts", "src/app/core/state/**", "src/app/core/export/**"]
}
